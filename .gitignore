# ---------------------------------------------------------------
# NIRVAAN — ignored files
#
# Rule of thumb: secrets, generated data and anything a machine can
# rebuild from requirements.txt + alembic + scripts/seed.py.
# ---------------------------------------------------------------

# --- Secrets ---------------------------------------------------
# .env holds SECRET_KEY, SMTP credentials and database URLs.
# .env.example is committed; real .env files never are.
.env
.env.*
!.env.example

# --- Virtual environments --------------------------------------
.venv/
venv/
env/
ENV/
.python-version

# --- Python ----------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
dist/
*.egg-info/
.eggs/
pip-wheel-metadata/

# --- Tests / coverage / type checkers --------------------------
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Application data (rebuilt by alembic + scripts/seed.py) ---
# The SQLite database, its WAL/SHM sidecars, uploads and the RAG index
# are all generated. Keep the folders, not the contents.
data/*.db
data/*.db-shm
data/*.db-wal
data/*.sqlite
data/*.sqlite3
data/uploads/*
!data/uploads/.gitkeep
data/rag/*
!data/rag/.gitkeep

# --- Logs ------------------------------------------------------
*.log
logs/

# --- Translation working files ----------------------------------
# source_en.json and the parts/ fragments are regenerated by
# scripts/extract_ui_strings.py; the merged hi.json / ta.json are
# committed because they are the actual catalogs the app reads.
app/i18n/ui/source_en.json

# --- Editors / IDEs --------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
*.sublime-workspace

# --- OS --------------------------------------------------------
# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# --- Node (only if a Tailwind build step is ever added) --------
node_modules/
npm-debug.log*
yarn-error.log*

# --- Misc ------------------------------------------------------
*.bak
*.tmp
.cache/
