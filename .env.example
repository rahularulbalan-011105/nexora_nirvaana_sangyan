# ---------------------------------------------------------------
# NIRVAAN environment configuration
# Copy to .env and fill in.  NEVER commit .env.
# ---------------------------------------------------------------

APP_NAME=NIRVAAN
APP_ENV=development            # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string

# --- Database -------------------------------------------------
# PostgreSQL (primary / intended deployment target)
DATABASE_URL=postgresql+psycopg://nirvaan:nirvaan@localhost:5432/nirvaan
# Dev fallback when Postgres is not installed yet. Set to true to use
# a local SQLite file instead (schema stays Postgres-compatible).
USE_SQLITE_FALLBACK=true
SQLITE_PATH=data/nirvaan.db

# --- Sessions / security --------------------------------------
SESSION_COOKIE_NAME=nirvaan_session
SESSION_TTL_HOURS=72
COOKIE_SECURE=false           # MUST be true behind HTTPS in production
COOKIE_SAMESITE=lax
CSRF_COOKIE_NAME=nirvaan_csrf

# Rate limiting (per client IP)
RATE_LIMIT_LOGIN_PER_MIN=5
RATE_LIMIT_API_PER_MIN=60

# --- Redis (optional, for multiple workers) -------------------
# Leave blank for the single-process dev default: rate limits, the shared
# cache (AI provider health, repeated Talk answers) and background jobs then
# live in memory / a thread pool. Set it to share them across uvicorn workers
# and to run jobs on an RQ worker (`python scripts/worker.py`). Needs
# `pip install -r requirements-redis.txt`. If Redis is unreachable the app
# logs once and falls back to memory - it never refuses to start.
REDIS_URL=                     # e.g. redis://localhost:6379/0

# --- AI providers ---------------------------------------------
# Order of preference. Comma separated. First healthy provider wins.
AI_PROVIDER_ORDER=ollama,local
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_SECONDS=120
# Embeddings for RAG. If unavailable, a deterministic hashing embedder is used.
OLLAMA_EMBED_MODEL=qwen2.5:7b

# --- Market data (educational use only) -----------------------
# Leave blank to use the deterministic MockMarketDataProvider.
# Synthetic data is ALWAYS labelled as such in the UI.
MARKET_DATA_PROVIDER=mock      # mock | external | cached
MARKET_DATA_API_KEY=
MARKET_DATA_BASE_URL=

# --- Email (verification / password reset) --------------------
# Leave MAIL_BACKEND=console to print mails to stdout during development.
MAIL_BACKEND=console           # console | smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=no-reply@nirvaan.local

# --- Uploads ---------------------------------------------------
UPLOAD_DIR=data/uploads
MAX_UPLOAD_MB=10

# --- Walkthrough video ---------------------------------------
# Linked from the landing hero as "Watch Demo". Leave blank to hide
# the button rather than link to nothing.
DEMO_VIDEO_URL=
